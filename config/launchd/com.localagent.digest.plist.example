<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.localagent.digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__INSTALL_DIR__/scripts/daily_digest.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <!-- Fire at 08:00 local. If the host is asleep at 08:00, launchd runs it on wake;
       if it never fires at all, the MISSING push is itself the liveness alarm. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/logs/digest-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/logs/digest-launchd.err.log</string>
</dict>
</plist>

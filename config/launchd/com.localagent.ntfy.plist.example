<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.localagent.ntfy</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/bin/ntfy</string>
    <string>serve</string>
    <string>--config</string>
    <string>__HOME__/.config/ntfy/server.yml</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Same pattern as the hub: the private-mesh address may not exist yet at login,
       so retry the bind every ThrottleInterval seconds until it succeeds. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/logs/ntfy-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/logs/ntfy-launchd.err.log</string>
</dict>
</plist>

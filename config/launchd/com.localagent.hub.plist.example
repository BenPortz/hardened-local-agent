<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.localagent.hub</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__INSTALL_DIR__/scripts/hub.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on any exit. At login the private-mesh address may not be assigned yet, so
       the first bind can fail; launchd retries every ThrottleInterval seconds until it sticks. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/logs/hub-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/logs/hub-launchd.err.log</string>
</dict>
</plist>

# Run-mode toggle. Copy to mode.env on the agent host (mode.env is gitignored).
# default      = talk to the agent harness directly; orchestrator process not started.
# orchestrator = scheduler pulls projects from the queue and juggles them async.
MODE=default

# Paths (relative to the project root on the agent host)
AUDIT_LOG=./logs/audit.jsonl
ALLOWLIST_DIR=./allowlists
PROJECTS_DIR=./projects

# Host/binary overrides used by scripts/ (see docs/deployment.md)
# AGENT_HOME=~/.agent                       # token + credential directory
# AGENT_BIN=~/.local/bin/hermes             # agent harness CLI
# HUB_HOST=127.0.0.1                        # set to the private-mesh address in production
# NTFY_BASE=http://127.0.0.1:2586

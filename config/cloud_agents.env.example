# Optional cloud escalation: SUBSCRIPTION CLIs only, no API keys on the agent host.
# claude = Claude Code CLI with an existing subscription login
# chatgpt = Codex CLI with an existing subscription login
# Fallback chain on failure: claude -> chatgpt -> local model (see scripts/orchestrator/scheduler.py).
#
# The daily call cap is a runaway-loop backstop, not a spend cap: subscription usage has no
# marginal cost, but an agent stuck in a loop should still hit a wall. Resets midnight UTC.
CLOUD_DAILY_CAP=20
